# Vercel KV (Redis) Environment Variables
# Injected automatically when linking a Vercel KV database in the Vercel Dashboard

KV_URL="redis://default:YOUR_KV_PASSWORD@YOUR_KV_HOST:6379"
KV_REST_API_URL="https://YOUR_KV_HOST.kv.vercel-storage.com"
KV_REST_API_TOKEN="YOUR_KV_REST_API_TOKEN"
KV_REST_API_READ_ONLY_TOKEN="YOUR_KV_REST_API_READ_ONLY_TOKEN"
